{
  "name": "um-sonho-de-rotina",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@noble/hashes": "^1.8.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.24",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.19",
    "expo-local-authentication": "~57.0.3",
    "expo-notifications": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "~19.2.2",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "export:web": "expo export --platform web",
    "prepare": "node scripts/prepare-assets.cjs",
    "prestart": "node scripts/prepare-assets.cjs",
    "preweb": "node scripts/prepare-assets.cjs",
    "pretypecheck": "node scripts/prepare-assets.cjs",
    "pretest": "node scripts/prepare-assets.cjs",
    "build": "node scripts/prepare-assets.cjs --public && expo export --platform web --output-dir dist && node scripts/build-pwa.cjs"
  },
  "private": true
}
